# Скопируйте файл в .env и заполните значения: cp .env.example .env
# На Amvera эти же значения задаются в разделе «Переменные окружения»,
# а файл .env в репозиторий не коммитится.

# --- Доступ к модели (обязательно) ---------------------------------------
# Вариант А. Любой сторонний шлюз / «AI-роутер» по подписке.
# Адрес и имя модели берутся из документации вашего провайдера.
OPERON_LLM_BASE_URL=https://ваш-шлюз/v1
OPERON_LLM_API_KEY=
OPERON_MODEL=
# Протокол шлюза. Если не уверены — запустите `python -m app.probe`,
# он определит рабочий протокол сам.
# OPERON_LLM_PROTOCOL=openai       # openai | anthropic

# Вариант Б. OpenRouter
# OPENROUTER_API_KEY=sk-or-v1-...
# OPERON_MODEL=anthropic/claude-opus-4.1

# Вариант В. Прямой доступ к Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# OPERON_MODEL=claude-opus-5

# --- Интернет-поиск ------------------------------------------------------
# Нужен, если модель идёт через сторонний шлюз: серверный поиск Anthropic
# в этом случае недоступен. Достаточно одного ключа.
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SERPER_API_KEY=
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_ID=

# --- Пароль на вход (обязателен при публичном доступе) -------------------
# Без него приложение откажется слушать внешний адрес: на сервере лежит
# OAuth-токен Google, и открытый чат = открытый доступ к вашему Диску.
OPERON_ACCESS_PASSWORD=
# Ключ подписи сессионных кук. Если пусто — генерируется и хранится на диске.
OPERON_SESSION_SECRET=
OPERON_AUTH_TTL_HOURS=168

# --- Организация ---------------------------------------------------------
OPERON_ORG_NAME=OPERON
OPERON_TIMEZONE=Europe/Moscow
# Публичный адрес приложения (для Secure-кук и заголовков OpenRouter)
OPERON_PUBLIC_URL=https://ваш-проект.amvera.io

# --- Параметры модели ----------------------------------------------------
OPERON_MAX_TOKENS=32000
OPERON_MAX_TOOL_ITERATIONS=24
# Расширения Anthropic. Через сторонний шлюз выключены по умолчанию,
# потому что он не обязан их поддерживать. Включайте, если проверили.
# OPERON_EFFORT=high            # low | medium | high | xhigh | max
# OPERON_USE_EFFORT=false
# OPERON_USE_PROMPT_CACHE=false
# OPERON_WEB_SEARCH=false       # серверный веб-поиск Anthropic

# --- Данные --------------------------------------------------------------
# В контейнере эти пути указывают на постоянный диск /data (см. Dockerfile).
OPERON_KB_DIR=knowledge_base
OPERON_DATA_DIR=data
OPERON_CREDENTIALS_DIR=credentials

# --- Google Workspace ----------------------------------------------------
# OPERON_GOOGLE_CLIENT_SECRET=credentials/client_secret.json
# Чтобы запретить запись, уберите drive.file и замените calendar на calendar.readonly
# OPERON_GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/calendar

# --- Сервер --------------------------------------------------------------
# В контейнере: 0.0.0.0. Локально оставьте 127.0.0.1.
OPERON_HOST=127.0.0.1
OPERON_PORT=8000

# --- Сессии --------------------------------------------------------------
OPERON_MAX_HISTORY=200
OPERON_SESSION_TTL_MINUTES=720
