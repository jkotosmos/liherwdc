# Скопируйте файл в .env и заполните значения: cp .env.example .env

# --- Обязательно ---------------------------------------------------------
# Ключ Anthropic API: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Организация ---------------------------------------------------------
OPERON_ORG_NAME=OPERON
OPERON_TIMEZONE=Europe/Moscow

# --- Модель --------------------------------------------------------------
# Уровень усилий: low | medium | high | xhigh | max
# high — разумный баланс; medium дешевле и быстрее на типовых вопросах.
OPERON_MODEL=claude-opus-5
OPERON_EFFORT=high
OPERON_MAX_TOKENS=64000

# Сколько раз за один ход агент может обратиться к инструментам.
OPERON_MAX_TOOL_ITERATIONS=24

# --- Данные --------------------------------------------------------------
# Каталог базы знаний. Для демонстрации: examples/demo_kb
OPERON_KB_DIR=knowledge_base
OPERON_DATA_DIR=data
OPERON_CREDENTIALS_DIR=credentials

# --- Интернет ------------------------------------------------------------
OPERON_WEB_SEARCH=true
OPERON_WEB_SEARCH_MAX_USES=8

# --- Google Workspace ----------------------------------------------------
# Путь к OAuth-клиенту (Desktop app) из Google Cloud Console.
# OPERON_GOOGLE_CLIENT_SECRET=credentials/client_secret.json
#
# Права доступа. По умолчанию Drive только на чтение (drive.readonly) плюс
# drive.file — запись ограничена файлами, созданными этим приложением.
# Чтобы полностью запретить запись в Drive, уберите drive.file.
# Чтобы сделать календарь доступным только для чтения, замените
# .../auth/calendar на .../auth/calendar.readonly
# OPERON_GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/calendar

# --- Сервер --------------------------------------------------------------
OPERON_HOST=127.0.0.1
OPERON_PORT=8000

# --- Сессии --------------------------------------------------------------
OPERON_MAX_HISTORY=200
OPERON_SESSION_TTL_MINUTES=720
