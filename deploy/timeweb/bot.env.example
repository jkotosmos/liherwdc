# Бот ассистента OPERON → скопируйте в bot.env
# Можно взять файл переменных с Amvera целиком. QDRANT_URL/QDRANT_API_KEY,
# OPERON_PUBLIC_URL, OPERON_HOST/PORT задаёт docker-compose.yml — их здесь не нужно.
ROUTERAI_API_KEY=
OPERON_MODEL=openai/gpt-4.1-mini
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=1107365044,8058569481,198704816
OPERON_ACCESS_PASSWORD=
OPERON_TOKEN_KEY=
OPERON_ORG_NAME=OPERON
OPERON_TIMEZONE=Europe/Moscow
QDRANT_EMBEDDING_MODEL=google/gemini-embedding-2
