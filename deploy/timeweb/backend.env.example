# Бэкенд сайта базы знаний → скопируйте в backend.env
# MONGODB_URI, QDRANT_URL, MAIN_DOMAIN, PORT, NODE_ENV задаёт docker-compose.yml.

# Администратор сайта (создаётся при первом запуске)
LOGIN_SUPER_ADMIN=admin
PASSWORD_SUPER_ADMIN=
EMAIL_SUPER_ADMIN=

# Секреты входа (любые длинные случайные строки: openssl rand -hex 32)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# RouterAI (дальше меняется в интерфейсе: «Настройки системы»)
ROUTER_AI_API_KEY=
ROUTER_AI_BASE_URL=https://routerai.ru/api/v1

# Google Drive для сайта (дальше — в интерфейсе)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://kb.example.ru/settings/google-callback

# Хранилище файлов Yandex Cloud
YANDEX_ACCESS_KEY_ID=
YANDEX_SECRET_ACCESS_KEY=
BUCKET_NAME=operon

# Почта (сброс пароля, двухфакторный вход)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Telegram-бот САЙТА — ДРУГОЙ бот, не @OperonAdmin_bot (иначе оба перестанут отвечать)
TG_BOT_TOKEN=
