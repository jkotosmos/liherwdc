# Сервер приложения → скопируйте в .env и заполните.
# Домены: A-записи на публичный IP ЭТОГО сервера; сертификаты выпустятся сами.
KB_DOMAIN=kb.example.ru
BOT_DOMAIN=bot.example.ru

# Сервер баз в канале WireGuard (менять не нужно).
DB_HOST=10.8.0.1

# Те же значения, что в .env сервера баз.
MONGO_APP_PASSWORD=
MONGO_BOT_PASSWORD=
QDRANT_API_KEY=
QDRANT_READ_KEY=
