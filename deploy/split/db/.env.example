# Сервер баз → скопируйте в .env и заполните.
# Пароли — только латиница и цифры (они идут в адрес подключения MongoDB):
#   openssl rand -hex 24
# Те же MONGO_APP_PASSWORD, MONGO_BOT_PASSWORD, QDRANT_API_KEY, QDRANT_READ_KEY
# должны стоять в .env сервера приложения.

# Адрес этого сервера в канале WireGuard (менять не нужно).
WG_IP=10.8.0.1

# Администратор MongoDB — только для обслуживания, приложениям не выдаётся.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=

# Пользователь сайта (чтение и запись базы operon).
MONGO_APP_PASSWORD=
# Пользователь бота (только чтение базы operon).
MONGO_BOT_PASSWORD=

# Qdrant: полный ключ — сайту, ключ только на чтение — боту.
QDRANT_API_KEY=
QDRANT_READ_KEY=
